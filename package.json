{
  "name": "aicore-office",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "npm run dev --workspace=apps/api",
    "dev:web": "npm run dev --workspace=apps/web",
    "build": "npm run build --workspace=apps/api && npm run build --workspace=apps/web",
    "typecheck": "npm run typecheck --workspace=apps/api && npm run typecheck --workspace=apps/web && npm run typecheck --workspace=apps/mcp-server",
    "seed": "tsx scripts/seed.ts",
    "mock": "tsx scripts/mock-events.ts",
    "assets": "node scripts/fetch-assets.mjs",
    "models:scan": "node scripts/inspect-models.mjs",
    "test": "npm run test --workspace=apps/api && npm run test --workspace=apps/web && npm run test:adapters",
    "test:adapters": "vitest run adapters",
    "lint": "eslint . --ext .ts,.tsx"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "concurrently": "^8.2.2",
    "dotenv": "^16.4.5",
    "tsx": "^4.7.0",
    "vitest": "^1.6.0",
    "eslint": "^8.56.0",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0"
  }
}
