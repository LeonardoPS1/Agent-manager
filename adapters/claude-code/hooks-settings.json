{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "node adapters/claude-code/emit.mjs SessionStart" }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "node adapters/claude-code/emit.mjs UserPromptSubmit" }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "node adapters/claude-code/emit.mjs PreToolUse" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "node adapters/claude-code/emit.mjs PostToolUse" }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          { "type": "command", "command": "node adapters/claude-code/emit.mjs Notification" }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          { "type": "command", "command": "node adapters/claude-code/emit.mjs SubagentStop" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "node adapters/claude-code/emit.mjs Stop" }
        ]
      }
    ]
  },
  "env": {
    "OFFICE_API_URL": "http://localhost:3000",
    "OFFICE_AGENT_ID": "claude-code"
  }
}
