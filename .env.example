# Aicore Office - Environment Variables

# API
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
API_URL=http://localhost:3000

# Database
POSTGRES_USER=office
POSTGRES_PASSWORD=office_dev
POSTGRES_DB=office_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://office:office_dev@postgres:5432/office_db

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# Auth
JWT_SECRET=change_me_in_prod_super_secret_key
TOKEN_SALT_ROUNDS=10

# Web
VITE_API_URL=http://localhost:3000
VITE_WS_URL=ws://localhost:3000

# MCP Server
OFFICE_MCP_TOKEN=change_me_mcp_token
OFFICE_API_URL=http://api:3000

# CORS
CORS_ORIGIN=http://localhost:5173
